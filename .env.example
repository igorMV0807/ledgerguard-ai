# Public portfolio mode. Keep this true for every public deployment.
NEXT_PUBLIC_DEMO_MODE=true

# Reserved for a future isolated Supabase sandbox. Never use production values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only placeholders. Never add NEXT_PUBLIC_ to these variables.
SUPABASE_SECRET_KEY=
SHOPIFY_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
N8N_WEBHOOK_SECRET=
